@model ContactMessage
@{
    ViewData["Title"] = "Contact";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />

<div class="page-wrap">
    <div class="bg1"></div>
    <div class="bg2"></div>
    <div class="bgrid"></div>

    <div class="content">
        <div>
            <div class="badge">
                <div class="badge-dot"></div>
                <span class="badge-text">Get in touch</span>
            </div>
            <h1 class="page-h1">Let's <span class="grad">talk.</span></h1>
            <p class="page-sub">
                Have a question, an idea, or a project to discuss?
                Drop us a note and we'll get back to you within one business day.
            </p>

            <div class="info-list">
                <div class="info-item">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <div>
                        <div class="info-label">Email</div>
                        <div class="info-val">hello@mymvcapp.local</div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="info-label">Phone</div>
                        <div class="info-val">+1 (555) 010-2026</div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <div class="info-label">Office</div>
                        <div class="info-val">Remote-first &middot; worldwide</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <h2>Send us a message</h2>
            <p class="sub">We typically reply within a few hours.</p>

            @if (TempData["ContactSuccess"] is string success)
            {
                <div class="alert-success">@success</div>
            }

            <form asp-action="Send" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="field">
                    <label asp-for="Name">Your name</label>
                    <input asp-for="Name" placeholder="Jane Doe" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" placeholder="jane@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Message">Message</label>
                    <textarea asp-for="Message" rows="5" placeholder="Tell us a bit about what you're working on..."></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <button type="submit" class="submit-btn">Send message</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
