@model BlogPost
@{
    ViewData["Title"] = "New Post";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />

<div class="page-wrap">
    <div class="bg1"></div>
    <div class="bg2"></div>
    <div class="bgrid"></div>

    <div class="page-header">
        <div class="badge">
            <div class="badge-dot"></div>
            <span class="badge-text">Compose</span>
        </div>
        <h1 class="page-h1">Write a <span class="grad">new post.</span></h1>
        <p class="page-sub">Fill in the details and publish to the journal.</p>
    </div>

    <form asp-action="Create" method="post" class="post-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <label asp-for="Title">Title</label>
            <input asp-for="Title" class="form-input" placeholder="A catchy title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Author">Author</label>
            <input asp-for="Author" class="form-input" placeholder="Your name" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="PublishedOn">Published on</label>
            <input asp-for="PublishedOn" type="date" class="form-input" />
            <span asp-validation-for="PublishedOn" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Body">Body</label>
            <textarea asp-for="Body" class="form-input" rows="10" placeholder="Write something worth reading..."></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Publish</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
