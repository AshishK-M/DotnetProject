@model BlogPost
@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole(Roles.Admin);
}

<article>
    <h1>@Model.Title</h1>
    <p class="text-muted">By @Model.Author on @Model.PublishedOn.ToString("MMMM d, yyyy")</p>
    <p>@Model.Body</p>
</article>

<a asp-action="Index" class="btn btn-link">&larr; Back to blog</a>
@if (isAdmin)
{
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger ms-2">Delete</a>
}
