@{
    ViewData["Title"] = "Privacy Policy";
    var lastUpdated = new DateTime(2026, 4, 1);
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />

<div class="page-wrap">
    <div class="bg1"></div>
    <div class="bg2"></div>
    <div class="bgrid"></div>

    <div class="page-header">
        <div class="badge">
            <div class="badge-dot"></div>
            <span class="badge-text">Legal</span>
        </div>
        <h1 class="page-h1">Privacy <span class="grad">Policy.</span></h1>
        <div class="updated">Last updated @lastUpdated.ToString("MMMM d, yyyy")</div>
    </div>

    <div class="layout">
        <nav class="toc">
            <div class="toc-label">On this page</div>
            <ul>
                <li><a href="#overview">Overview</a></li>
                <li><a href="#data-we-collect">Data we collect</a></li>
                <li><a href="#how-we-use-data">How we use it</a></li>
                <li><a href="#sharing">Sharing</a></li>
                <li><a href="#your-rights">Your rights</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>

        <div class="doc-card">

            <section id="overview" class="doc">
                <h2 class="doc-h">Overview</h2>
                <p class="doc-p">
                    We respect your privacy and are committed to protecting your personal data.
                    This policy explains what we collect, how we use it, and the choices you have.
                </p>
            </section>

            <section id="data-we-collect" class="doc">
                <h2 class="doc-h">Data we collect</h2>
                <div class="tile-grid">
                    <div class="tile">
                        <div class="tile-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <div class="tile-name">Account info</div>
                        <p class="tile-desc">Name and email address you give us when you sign up or contact us.</p>
                    </div>
                    <div class="tile">
                        <div class="tile-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                                <line x1="18" y1="20" x2="18" y2="10"/>
                                <line x1="12" y1="20" x2="12" y2="4"/>
                                <line x1="6" y1="20" x2="6" y2="14"/>
                            </svg>
                        </div>
                        <div class="tile-name">Usage data</div>
                        <p class="tile-desc">Pages visited, features used, and basic device information.</p>
                    </div>
                    <div class="tile">
                        <div class="tile-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                                <line x1="9" y1="9" x2="9.01" y2="9"/>
                                <line x1="15" y1="9" x2="15.01" y2="9"/>
                            </svg>
                        </div>
                        <div class="tile-name">Cookies</div>
                        <p class="tile-desc">Small files used to keep you signed in and remember preferences.</p>
                    </div>
                    <div class="tile">
                        <div class="tile-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </div>
                        <div class="tile-name">Communications</div>
                        <p class="tile-desc">Messages you send through our contact forms or support channels.</p>
                    </div>
                </div>
            </section>

            <section id="how-we-use-data" class="doc">
                <h2 class="doc-h">How we use it</h2>
                <ul class="check-list">
                    <li><span class="check-pill">&#10003;</span><span>Provide, maintain, and improve our services.</span></li>
                    <li><span class="check-pill">&#10003;</span><span>Respond to your questions and support requests.</span></li>
                    <li><span class="check-pill">&#10003;</span><span>Detect and prevent fraud, abuse, and security incidents.</span></li>
                    <li><span class="check-pill">&#10003;</span><span>Comply with legal obligations.</span></li>
                </ul>
            </section>

            <section id="sharing" class="doc">
                <h2 class="doc-h">Sharing</h2>
                <div class="callout">
                    <div class="callout-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                    </div>
                    <div>
                        We do <strong>not</strong> sell your personal data. We share information only with
                        trusted service providers that help us operate our platform, and only as needed
                        to deliver the service.
                    </div>
                </div>
            </section>

            <section id="your-rights" class="doc">
                <h2 class="doc-h">Your rights</h2>
                <p class="doc-p">
                    You have the right to access, correct, export, or delete your personal data at any time.
                    You can also opt out of non-essential communications.
                </p>
            </section>

            <section id="contact" class="doc">
                <h2 class="doc-h">Contact</h2>
                <p class="doc-p" style="margin-bottom: 18px;">
                    Questions about this policy? We're here to help.
                </p>
                <a asp-controller="Contact" asp-action="Index" class="cta-btn">Get in touch</a>
            </section>

        </div>
    </div>
</div>
